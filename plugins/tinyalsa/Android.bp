        "libagmclient",
        "libcutils",
        "libutils",
        "liblog",
    ] + select(soong_config_variable("qtiaudio", "target_uses_qti_tinycompress"), {
        "true": [
            "libqti-tinyalsa",
            "libqti-tinycompress",
        ],
        "false": [
            "libtinyalsa",
            "libtinycompress",
        ],
        default: [
            "libtinyalsa",
            "libtinycompress",
        ],
    }),
}

cc_library_shared {
    name: "libagm_compress_plugin",
    vendor: true,
    srcs: ["src/agm_compress_plugin.c"],
    cflags: [
        "-Wno-format",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-unused-function",
    ],
    include_dirs: [
        "external/expat/lib",
    ],
    header_libs: [
        "libagm_headers",
        "qti_kernel_headers",
    ] + select(soong_config_variable("qtiaudio", "audio_feature_enabled_dynamic_log"), {
        "true": [
            "libaudiologutils_headers",
        ],
        default: [
        ],
    }),
    shared_libs: [
        "libsndcardparser",
        "libagmclient",
        "libutils",
        "libcutils",
        "liblog",
    ] + select(soong_config_variable("qtiaudio", "target_uses_qti_tinycompress"), {
        "true": [
            "libqti-tinyalsa",
            "libqti-tinycompress",
        ],
        "false": [
            "libtinyalsa",
            "libtinycompress",
        ],
        default: [
            "libtinyalsa",
            "libtinycompress",
        ],
    }),
}
