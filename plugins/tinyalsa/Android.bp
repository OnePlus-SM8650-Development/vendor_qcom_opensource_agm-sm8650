cc_library_shared {
    name: "libagm_pcm_plugin",
    vendor: true,
    srcs: ["src/agm_pcm_plugin.c"],
    cflags: [
        "-Wall",
        "-Wno-format",
        "-Wno-incompatible-pointer-types",
        "-Wno-enum-conversion",
    ],
    include_dirs: [
        "system/media/audio_route/include",

        "external/tinycompress/include",
    ],
    header_libs: [
        "libagm_headers",
        "qti_kernel_headers",
    ] + select(soong_config_variable("qtiaudio", "audio_feature_enabled_dynamic_log"), {
        "true": [
            "libaudiologutils_headers",
        ],
        default: [
        ],
    }),
    shared_libs: [
        "libsndcardparser",
        "libagmclient",
        "libutils",
        "libcutils",
        "liblog",
    ] + select(soong_config_variable("qtiaudio", "target_uses_qti_tinycompress"), {
        "true": [
            "libqti-tinyalsa",
            "libqti-tinycompress",
        ],
        "false": [
            "libtinyalsa",
            "libtinycompress",
        ],
        default: [
            "libtinyalsa",
            "libtinycompress",
        ],
    }),
}

