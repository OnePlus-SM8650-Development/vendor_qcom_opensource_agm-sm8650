// Copyright (C) 2025 The XPerience Project

cc_library_shared {
    name: "libagmmixer",
    owner: "qti",
    vendor: true,
    srcs: ["agmmixer.c"],
    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-result",
        "-Wno-unused-variable",
    ],
    include_dirs: [
        "system/media/audio_route/include",
        "system/media/audio_utils/include",
		"external/tinycompress/include"],
    header_libs: [
        "libagm_headers",
        "libarpal_headers",
        "qti_kernel_headers",
    ],

    shared_libs: [
		"libaudioroute",
		"libexpat",
        "libtinyalsa",
        "libtinycompress",
     ],
    sanitize: {
        integer_overflow: true,
    },
}

// agmplay
cc_binary {
    name: "agmplay",
    owner: "qti",
    vendor: true,
    srcs: ["agmplay.c"],
    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-result",
        "-Wno-unused-variable",
        "-Wno-format-insufficient-args",
        "-DBACKEND_CONF_FILE=\"/vendor/etc/backend_conf.xml\"",
    ],
    header_libs: [
        "libagm_headers",
        "libarpal_headers",
        "qti_kernel_headers",
    ],
    shared_libs: [
        "libagmmixer",
        ] + select(soong_config_variable("qtiaudio", "target_uses_qti_tinycompress"), {
            "true": [
                "libqti-tinyalsa",
                "libqti-tinycompress"
            ],
            "false": [
                "libtinyalsa",
                "libtinycompress"
            ],
            default: [
                "libtinyalsa",
                "libtinycompress"
            ],
        }),
}

